# MCP Server for Power BI Environment Variables
# Copy this file to .env and fill in your values

# ===== OAuth/Entra ID Configuration =====
# HTTP server port (default: 3001)
PORT=3001

# Azure AD Tenant ID
TENANT_ID=your-tenant-id-here

# Application ID (client ID) that this MCP server is registered as
# This is the API application ID that receives tokens from LibreChat
AUDIENCE=your-api-app-id-here

# ===== Authentication mode =====
# How the server obtains a Power BI token:
#   obo          On-Behalf-Of exchange of the caller's token. Requires the
#                client credentials below.
#   passthrough  DEPRECATED. Sends the caller's own token on to Power BI. The
#                MCP authorization spec prohibits accepting a token that was
#                not issued for this server; this mode will be removed.
# Unset defaults to obo when client credentials are present, and otherwise
# refuses to start rather than picking a scheme for you.
AUTH_MODE=obo

# Client credentials for the Entra ID application this server acts as.
ENTRA_CLIENT_ID=your-client-id-here
ENTRA_CLIENT_SECRET=your-client-secret-here

# Deprecated aliases, still honoured: OBO_CLIENT_ID / OBO_CLIENT_SECRET,
# and the bare CLIENT_ID / CLIENT_SECRET.

# ===== Optional: Required Scopes and Roles =====
# Comma-separated list of required scopes in the access token
REQUIRED_SCOPES=mcp.access

# Comma-separated list of required roles in the access token
REQUIRED_ROLES=mcp.user

# ===== Logging =====
# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# ===== Test Client Configuration (for testing OAuth flow) =====
# Client application ID for testing
TESTCLIENT_CLIENT_ID=your-test-client-id-here

# Scopes to request when testing
TESTCLIENT_SCOPE="api://your-api-app-id/mcp.access openid profile offline_access"

