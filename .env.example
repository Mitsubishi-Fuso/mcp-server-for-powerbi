# MCP Server for Power BI Environment Variables
# Copy this file to .env and fill in your values

# ===== OAuth/Entra ID Configuration =====
# HTTP server port (default: 3001)
PORT=3001

# Azure AD Tenant ID
TENANT_ID=your-tenant-id-here

# Application ID (client ID) that this MCP server is registered as
# This is the API application ID that receives tokens from LibreChat
AUDIENCE=your-api-app-id-here

# ===== Authentication mode =====
# How the server obtains a Power BI token:
#   obo      On-Behalf-Of exchange of the caller's token. Nothing long-lived is
#            stored, but the exchange re-evaluates conditional access
#            server-side, where the user cannot answer a challenge.
#   custody  The server brokers the user's sign-in, keeps the refresh token,
#            and issues the MCP client a credential of its own. Conditional
#            access is satisfied in the browser at sign-in.
# Unset defaults to obo when client credentials are present, and otherwise
# refuses to start rather than picking a scheme for you.
AUTH_MODE=obo

# Client credentials for the Entra ID application this server acts as. Needed
# by both modes. Deprecated aliases, still honoured: OBO_CLIENT_ID /
# OBO_CLIENT_SECRET, and the bare CLIENT_ID / CLIENT_SECRET.
ENTRA_CLIENT_ID=your-client-id-here
ENTRA_CLIENT_SECRET=your-client-secret-here

# ===== Custody mode only =====
# The address browsers and MCP clients reach this server on. Entra redirects
# back to PUBLIC_URL/callback, which must be a redirect URI on the app
# registration above.
# PUBLIC_URL=https://powerbi-mcp.example.com

# Exact redirect URIs of the MCP clients allowed to sign in, comma separated.
# Required: without it any caller could have an authorization code delivered
# wherever it liked. Matched exactly, never by prefix.
# CUSTODY_REDIRECT_URIS=https://librechat.example.com/api/mcp/powerbi/oauth/callback

# Optional allowlist of client_id values. Unset accepts any, relying on the
# redirect URI allowlist and PKCE.
# CUSTODY_CLIENT_IDS=librechat

# Encrypts the refresh tokens the server holds. Required in custody mode.
# Generate with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# SESSION_ENCRYPTION_KEY=

# ===== Optional: Required Scopes and Roles =====
# Comma-separated list of required scopes in the access token
REQUIRED_SCOPES=mcp.access

# Comma-separated list of required roles in the access token
REQUIRED_ROLES=mcp.user

# ===== Logging =====
# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# ===== Test Client Configuration (for testing OAuth flow) =====
# Client application ID for testing
TESTCLIENT_CLIENT_ID=your-test-client-id-here

# Scopes to request when testing
TESTCLIENT_SCOPE="api://your-api-app-id/mcp.access openid profile offline_access"

